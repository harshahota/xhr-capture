{
  "manifest_version": 3,
  "name": "XHR Capture",
  "version": "1.1.0",
  "description": "Adds a DevTools tab that lists XHR and fetch calls with headers, payloads and responses. Export to JSON, CSV or Postman.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XHR Capture",
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html"
}
